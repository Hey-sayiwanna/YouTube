#!name=YouTube首页去广告
#!desc=针对 iOS YouTube 首页推荐流 Sponsored/Feed 广告的定向补丁。v5 修复 Surge JSC 缺少 TextEncoder 导致脚本中止的问题；仅接管 /youtubei/v1/browse，可与现有 YouTube Enhance、双语字幕模块共存。
#!category=YouTube
#!system=ios
#!version=2026.09.02.5

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Script]
YouTube.HomeFeedAdBlock.v5 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,debug=true,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube/main/YouTube%E9%A6%96%E9%A1%B5%E5%8E%BB%E5%B9%BF%E5%91%8A/YouTube%E9%A6%96%E9%A1%B5%E5%8E%BB%E5%B9%BF%E5%91%8A.js?v=20260902.5

[MITM]
hostname = %APPEND% youtubei.googleapis.com
