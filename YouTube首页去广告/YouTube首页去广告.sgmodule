#!name=YouTube首页去广告
#!desc=针对 iOS YouTube 首页推荐流 Sponsored/Feed 广告的定向补丁。v9 扩展广告识别：兼容 MyRepublic 这类不再携带旧 googleadservices/adview 组合、改用 paralleladinteraction 与 doubleclick pagead 的新结构；只要 Feed item 含 aboutthisad 即直接删除，同时保留旧结构、灰框清理与 WebView 低内存处理。
#!category=YouTube
#!system=ios
#!version=2026.09.03.9

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Script]
YouTube.HomeFeedAdBlock.v9 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,debug=true,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube/main/YouTube%E9%A6%96%E9%A1%B5%E5%8E%BB%E5%B9%BF%E5%91%8A/YouTube%E9%A6%96%E9%A1%B5%E5%8E%BB%E5%B9%BF%E5%91%8A.js?v=20260903.9

[MITM]
hostname = %APPEND% youtubei.googleapis.com
