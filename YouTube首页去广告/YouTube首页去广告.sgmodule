#!name=YouTube 首页去广告（已迁移）
#!desc=项目已迁移到独立仓库 Hey-sayiwanna/YouTube-ADBlock-on-Feed。此兼容入口仅用于让旧订阅平滑更新，实际脚本已从新仓库加载。
#!category=YouTube
#!system=ios
#!version=2026.09.05.9

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Script]
YouTube.HomeFeedAdBlock.v9 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,debug=true,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube-ADBlock-on-Feed/main/YouTube.HomeFeedAdBlock.js?v=20260905.9

[MITM]
hostname = %APPEND% youtubei.googleapis.com
