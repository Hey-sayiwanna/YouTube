#!name=YouTube首页去广告
#!desc=针对 iOS YouTube 首页推荐流 Sponsored/Feed 广告的定向补丁。v8 修复 v7 只识别旧 protobuf 路径的问题：现在会在前 8 层中定位 Home Feed 容器 field #49399797，同时兼容旧 field #32 与新 field #1 广告 item，并清理相邻 divider/历史空壳；继续使用 WebView 引擎降低大响应内存压力。
#!category=YouTube
#!system=ios
#!version=2026.09.02.8

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Script]
YouTube.HomeFeedAdBlock.v8 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,debug=true,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/YouTube/main/YouTube%E9%A6%96%E9%A1%B5%E5%8E%BB%E5%B9%BF%E5%91%8A/YouTube%E9%A6%96%E9%A1%B5%E5%8E%BB%E5%B9%BF%E5%91%8A.js?v=20260902.8

[MITM]
hostname = %APPEND% youtubei.googleapis.com
